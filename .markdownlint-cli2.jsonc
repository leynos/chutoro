{
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD029": { "style": "ordered" }
  },
  "ignores": [
    "**/.venv/**",
    // Generated third-party Verus installation Markdown is outside repository ownership and must not be formatted or linted.
    "**/.verus/**",
    ".node_modules/**",
    "**/node_modules/**",
    "**/target/**",
    ".vtcode/**",
    ".terraform/**",
    ".uv-cache/**",
    "memories/**",
    "CRUSH.md"
  ]
}
